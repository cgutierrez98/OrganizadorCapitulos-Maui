@using OrganizadorCapitulos.Maui.Models
@using organizadorCapitulos.Core.Enums
@using System.Collections.ObjectModel
@using System.Threading
@implements IDisposable

<div class="file-list-shell">
    <!-- Compact Toolbar -->
    <div class="file-list-toolbar" role="toolbar" aria-label="Controles de lista">
        <div class="file-search-box">
            <span class="file-search-icon" aria-hidden="true">
                <Icon Name="search" Size="13" />
            </span>
            <input type="text" class="file-search-input"
                   @bind="_searchInput" @bind:event="oninput" @bind:after="OnSearchInputChanged"
                   placeholder="Filtrar archivos..."
                   aria-label="Filtrar archivos" />
            @if (!string.IsNullOrEmpty(_searchInput))
            {
                <button type="button" class="file-search-clear" @onclick="ClearSearch" aria-label="Limpiar búsqueda" title="Limpiar">
                    <Icon Name="x" Size="12" />
                </button>
            }
        </div>

        <div class="filter-tabs" role="group" aria-label="Filtros por estado">
            <button type="button" class="filter-tab @(CurrentFilter == null ? "active" : "")"
                    @onclick="() => SetFilter(null)" aria-pressed="@(CurrentFilter == null)">
                <span>Todos</span>
                <span class="filter-tab-count">@Files.Count</span>
            </button>
            <button type="button" class="filter-tab @(CurrentFilter == FileStatus.Pending ? "active" : "")"
                    @onclick="() => SetFilter(FileStatus.Pending)" aria-pressed="@(CurrentFilter == FileStatus.Pending)">
                <span>Pendientes</span>
                <span class="filter-tab-count">@_pendingCount</span>
            </button>
            <button type="button" class="filter-tab @(CurrentFilter == FileStatus.Analyzed ? "active" : "")"
                    @onclick="() => SetFilter(FileStatus.Analyzed)" aria-pressed="@(CurrentFilter == FileStatus.Analyzed)">
                <span>Listos</span>
                <span class="filter-tab-count">@_analyzedCount</span>
            </button>
            <button type="button" class="filter-tab @(CurrentFilter == FileStatus.Done ? "active" : "")"
                    @onclick="() => SetFilter(FileStatus.Done)" aria-pressed="@(CurrentFilter == FileStatus.Done)">
                <span>Hechos</span>
                <span class="filter-tab-count">@_doneCount</span>
            </button>
            @if (_errorCount > 0 || CurrentFilter == FileStatus.Error)
            {
                <button type="button" class="filter-tab @(CurrentFilter == FileStatus.Error ? "active" : "")"
                        @onclick="() => SetFilter(FileStatus.Error)" aria-pressed="@(CurrentFilter == FileStatus.Error)">
                    <span>Errores</span>
                    <span class="filter-tab-count">@_errorCount</span>
                </button>
            }
        </div>

        <div class="toolbar-view-controls">
            <button type="button" class="cmd-btn-ghost" @onclick='() => SortBy("Name")'
                    style="@(SortColumn == "Name" ? "color: var(--text-primary); background: var(--bg-subtle);" : "")"
                    title="Ordenar por nombre">
                <span>Nombre</span>
                @if (SortColumn == "Name")
                {
                    <Icon Name="@(SortAscending ? "arrow-up" : "arrow-down")" Size="12" />
                }
            </button>
            <button type="button" class="cmd-btn-ghost" @onclick='() => SortBy("Status")'
                    style="@(SortColumn == "Status" ? "color: var(--text-primary); background: var(--bg-subtle);" : "")"
                    title="Ordenar por estado">
                <span>Estado</span>
                @if (SortColumn == "Status")
                {
                    <Icon Name="@(SortAscending ? "arrow-up" : "arrow-down")" Size="12" />
                }
            </button>
            <button type="button" class="cmd-btn-ghost cmd-icon-btn" @onclick="ToggleViewMode"
                    aria-label="@(IsCompactView ? "Vista detallada" : "Vista compacta")"
                    title="@(IsCompactView ? "Cambiar a vista detallada" : "Cambiar a vista compacta")">
                <Icon Name="@(IsCompactView ? "list" : "align-justify")" Size="14" />
            </button>
        </div>
    </div>

    @if (Files.Count > 0)
    {
        <div class="file-list-header">
            <label class="file-col-check" title="Marcar o desmarcar todos">
                <input type="checkbox" checked="@_allChecked" @onchange="OnToggleAll" aria-label="Seleccionar todos" />
                <span class="tabular-nums">@_checkedCount/@Files.Count</span>
            </label>
            <div class="file-col-name">Archivo / Vista previa</div>
            <div class="file-col-status">Estado</div>
        </div>
    }

    @if (_visibleFiles.Count == 0)
    {
        <div class="empty-panel">
            <div class="empty-drop-frame">
                <div class="empty-icon-box">
                    <Icon Name="@(Files.Any() ? "search" : "folder-open")" Size="20" />
                </div>
                @if (Files.Any())
                {
                    <h3 class="empty-title">Sin coincidencias</h3>
                    <p class="empty-desc">Ningún archivo coincide con la búsqueda o el filtro seleccionado.</p>
                    <button type="button" class="cmd-btn" @onclick="ResetFilters">Limpiar filtros</button>
                }
                else
                {
                    <h3 class="empty-title">No hay archivos cargados</h3>
                    <p class="empty-desc">Abre una carpeta o arrastra archivos o carpetas de video directamente sobre la ventana.</p>
                    <button type="button" class="cmd-btn cmd-btn-primary" @onclick="() => OnOpenFolders.InvokeAsync()">
                        <Icon Name="folder-open" Size="14" />
                        <span>Abrir carpetas</span>
                        <span class="kbd-hint">Ctrl+O</span>
                    </button>
                }
            </div>
        </div>
    }
    else
    {
        <div class="file-items @(IsCompactView ? "file-items-compact" : "")"
             tabindex="0"
             @onkeydown="HandleKeyDown"
             role="list"
             aria-label="Lista de archivos (@_visibleFiles.Count)">
            <Virtualize Items="@_visibleFiles" Context="file" ItemSize="@(IsCompactView ? 36f : 54f)" OverscanCount="6">
                @{
                    var hasCollision = !string.IsNullOrEmpty(file.NewName) && _duplicatePreviews.Contains(file.NewName);
                }
                <div @key="file"
                     class="file-row-wrapper @(file.IsSelected ? "row-selected" : "") @(!file.IsChecked ? "row-unchecked" : "")"
                     role="listitem">
                    <div class="file-row-check">
                        <input type="checkbox" checked="@file.IsChecked"
                               @onchange="(e) => ToggleFileChecked(file, e)"
                               aria-label="Incluir @file.OriginalName" />
                    </div>

                    <button type="button" @onclick="() => SelectFile(file)"
                            class="file-row-button"
                            aria-pressed="@file.IsSelected">
                        <div class="file-row-main">
                            <span class="file-row-name" title="@file.OriginalName">@file.OriginalName</span>

                            @if (!string.IsNullOrEmpty(file.NewName))
                            {
                                <span class="file-row-preview-line">
                                    <Icon Name="arrow-right" Size="11" />
                                    <code class="file-row-preview @(hasCollision ? "preview-collision" : "")" title="@file.NewName">@file.NewName</code>
                                </span>
                            }
                            else if (!IsCompactView)
                            {
                                <span class="file-row-preview-empty">Sin vista previa</span>
                            }
                        </div>

                        <div class="file-row-meta">
                            @if (hasCollision)
                            {
                                <span class="collision-flag" title="Otro archivo genera el mismo nombre; se añadirá un sufijo único">
                                    <Icon Name="alert-triangle" Size="12" />
                                    <span>Colisión</span>
                                </span>
                            }
                            <span class="status-pill @GetStatusPillClass(file.Status)">
                                <span class="status-dot"></span>
                                <span>@GetStatusText(file.Status)</span>
                            </span>
                        </div>
                    </button>
                </div>
            </Virtualize>
        </div>
    }
</div>

@code {
    [Parameter]
    public ObservableCollection<FileViewModel> Files { get; set; } = new();

    [Parameter]
    public EventCallback<FileViewModel> OnFileSelected { get; set; }

    [Parameter]
    public EventCallback<bool> OnToggleAllChecked { get; set; }

    [Parameter]
    public EventCallback OnCheckChanged { get; set; }

    [Parameter]
    public EventCallback OnOpenFolders { get; set; }

    private FileStatus? CurrentFilter = null;
    private string _searchInput = "";
    private string SearchText = "";
    private string SortColumn = "Name";
    private bool SortAscending = true;
    private bool IsCompactView = false;

    private CancellationTokenSource? _searchDebounceCts;
    private List<FileViewModel> _visibleFiles = new();
    private HashSet<string> _duplicatePreviews = new(StringComparer.OrdinalIgnoreCase);
    private int _checkedCount;
    private int _pendingCount;
    private int _analyzedCount;
    private int _doneCount;
    private int _errorCount;
    private bool _allChecked;

    protected override void OnParametersSet()
    {
        RebuildViewState();
    }

    private void RebuildViewState()
    {
        int checkedCount = 0, pending = 0, analyzed = 0, done = 0, error = 0;
        var seenPreviews = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        var duplicates = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        var filtered = new List<FileViewModel>(Files.Count);
        var q = string.IsNullOrWhiteSpace(SearchText) ? null : SearchText.Trim();

        foreach (var f in Files)
        {
            if (f.IsChecked)
            {
                checkedCount++;
                if (!string.IsNullOrWhiteSpace(f.NewName) && !seenPreviews.Add(f.NewName))
                {
                    duplicates.Add(f.NewName);
                }
            }

            switch (f.Status)
            {
                case FileStatus.Pending: pending++; break;
                case FileStatus.Analyzed: analyzed++; break;
                case FileStatus.Done: done++; break;
                case FileStatus.Error: error++; break;
            }

            if (CurrentFilter.HasValue && f.Status != CurrentFilter.Value)
                continue;

            if (q != null &&
                !f.OriginalName.Contains(q, StringComparison.OrdinalIgnoreCase) &&
                !f.SeriesTitle.Contains(q, StringComparison.OrdinalIgnoreCase) &&
                !f.NewName.Contains(q, StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }

            filtered.Add(f);
        }

        if (SortColumn == "Name")
        {
            filtered.Sort((a, b) => SortAscending
                ? StringComparer.OrdinalIgnoreCase.Compare(a.OriginalName, b.OriginalName)
                : StringComparer.OrdinalIgnoreCase.Compare(b.OriginalName, a.OriginalName));
        }
        else if (SortColumn == "Status")
        {
            filtered.Sort((a, b) => SortAscending
                ? a.Status.CompareTo(b.Status)
                : b.Status.CompareTo(a.Status));
        }

        _checkedCount = checkedCount;
        _pendingCount = pending;
        _analyzedCount = analyzed;
        _doneCount = done;
        _errorCount = error;
        _allChecked = Files.Count > 0 && checkedCount == Files.Count;
        _duplicatePreviews = duplicates;
        _visibleFiles = filtered;
    }

    private async Task OnSearchInputChanged()
    {
        _searchDebounceCts?.Cancel();
        _searchDebounceCts?.Dispose();
        _searchDebounceCts = new CancellationTokenSource();
        var token = _searchDebounceCts.Token;

        try
        {
            if (!string.IsNullOrEmpty(_searchInput))
            {
                await Task.Delay(150, token);
            }
            if (!token.IsCancellationRequested)
            {
                SearchText = _searchInput;
                RebuildViewState();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Superseded by newer keystroke
        }
    }

    private void ClearSearch()
    {
        _searchDebounceCts?.Cancel();
        _searchInput = "";
        SearchText = "";
        RebuildViewState();
    }

    private void ResetFilters()
    {
        _searchDebounceCts?.Cancel();
        _searchInput = "";
        SearchText = "";
        CurrentFilter = null;
        RebuildViewState();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (_visibleFiles.Count == 0) return;

        if (e.Key is "ArrowDown" or "ArrowUp")
        {
            int currentIdx = _visibleFiles.FindIndex(f => f.IsSelected);
            int nextIdx = e.Key == "ArrowDown"
                ? Math.Min(_visibleFiles.Count - 1, currentIdx + 1)
                : (currentIdx <= 0 ? 0 : currentIdx - 1);

            if (nextIdx >= 0 && nextIdx < _visibleFiles.Count)
            {
                await SelectFile(_visibleFiles[nextIdx]);
            }
        }
    }

    private async Task OnToggleAll(ChangeEventArgs e)
    {
        bool check = e.Value is bool b && b;
        await OnToggleAllChecked.InvokeAsync(check);
        RebuildViewState();
    }

    private async Task ToggleFileChecked(FileViewModel file, ChangeEventArgs e)
    {
        file.IsChecked = e.Value is bool b && b;
        RebuildViewState();
        await OnCheckChanged.InvokeAsync();
    }

    private void SetFilter(FileStatus? filter)
    {
        CurrentFilter = filter;
        RebuildViewState();
    }

    private void SortBy(string column)
    {
        if (SortColumn == column) SortAscending = !SortAscending;
        else { SortColumn = column; SortAscending = true; }
        RebuildViewState();
    }

    private void ToggleViewMode() => IsCompactView = !IsCompactView;

    private async Task SelectFile(FileViewModel file) => await OnFileSelected.InvokeAsync(file);

    private static string GetStatusPillClass(FileStatus status) => status switch
    {
        FileStatus.Done => "status-done",
        FileStatus.Analyzed => "status-analyzed",
        FileStatus.Error => "status-error",
        _ => "status-pending"
    };

    private static string GetStatusText(FileStatus status) => status switch
    {
        FileStatus.Done => "Hecho",
        FileStatus.Analyzed => "Listo",
        FileStatus.Error => "Error",
        _ => "Pendiente"
    };

    public void Dispose()
    {
        _searchDebounceCts?.Cancel();
        _searchDebounceCts?.Dispose();
    }
}
