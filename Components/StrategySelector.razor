@using organizadorCapitulos.Core.Enums

<div class="d-flex flex-column gap-2">
    <div class="segmented-control" role="radiogroup" aria-label="Modo de renombrado">
        <button type="button"
                role="radio"
                aria-checked="@(SelectedMode == RenameMode.Maintain)"
                class="segmented-option @(SelectedMode == RenameMode.Maintain ? "active" : "")"
                @onclick="() => SelectMode(RenameMode.Maintain)">
            <span>Mantener</span>
        </button>

        <button type="button"
                role="radio"
                aria-checked="@(SelectedMode == RenameMode.Change)"
                class="segmented-option @(SelectedMode == RenameMode.Change ? "active" : "")"
                @onclick="() => SelectMode(RenameMode.Change)">
            <span>Estricto</span>
        </button>

        <button type="button"
                role="radio"
                aria-checked="@(SelectedMode == RenameMode.Movie)"
                class="segmented-option @(SelectedMode == RenameMode.Movie ? "active" : "")"
                @onclick="() => SelectMode(RenameMode.Movie)">
            <span>Películas</span>
        </button>
    </div>

    <p class="strategy-hint">@GetModeDescription(SelectedMode)</p>
</div>

@code {
    [Parameter]
    public RenameMode SelectedMode { get; set; }

    [Parameter]
    public EventCallback<RenameMode> OnModeChanged { get; set; }

    private async Task SelectMode(RenameMode mode)
    {
        if (SelectedMode != mode)
        {
            await OnModeChanged.InvokeAsync(mode);
        }
    }

    private static string GetModeDescription(RenameMode mode) => mode switch
    {
        RenameMode.Maintain => "Usa serie/temporada del primer archivo y numera episodios secuencialmente.",
        RenameMode.Change => "Mantiene exactamente la temporada y episodio de cada archivo.",
        RenameMode.Movie => "Formatea películas usando el título y el año de estreno.",
        _ => ""
    };
}
