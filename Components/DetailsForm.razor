@using OrganizadorCapitulos.Maui.Models
@using organizadorCapitulos.Core.Enums

@if (SelectedFile == null)
{
    <div class="empty-state empty-state-compact">
        <div class="empty-state-icon" aria-hidden="true">Editar</div>
        <div class="empty-state-copy">
            <h3>Selecciona un archivo</h3>
            <p>Cuando elijas una película o capítulo podrás revisar sus metadatos, aplicar cambios en lote y elegir la estrategia de renombrado.</p>
        </div>
    </div>
}
else
{
    <div class="details-stack">
        @if (SelectedMode == RenameMode.Movie)
        {
            <section class="editor-card">
                <div class="editor-card-header">
                    <span class="panel-kicker">Metadatos</span>
                    <h3 class="editor-card-title">Información de la película</h3>
                </div>

                <div class="field-group">
                    <div class="field-label-row">
                        <label class="form-label field-label mb-0" for="movie-title">Título de la película</label>
                    </div>
                    <input id="movie-title" type="text" class="form-control" @bind="SelectedFile.SeriesTitle"
                        @bind:after="OnChanged" placeholder="Ej: El Padrino" />
                </div>

                <div class="field-group">
                    <label class="form-label field-label" for="movie-year">Año de estreno</label>
                    <input id="movie-year" type="number" class="form-control" @bind="SelectedFile.Year"
                        @bind:after="OnChanged" placeholder="Ej: 1972" min="1880" max="2100" />
                </div>
            </section>
        }
        else
        {
            <section class="editor-card">
                <div class="editor-card-header">
                    <span class="panel-kicker">Metadatos</span>
                    <h3 class="editor-card-title">Información del episodio</h3>
                </div>

                <div class="field-group">
                    <div class="field-label-row">
                        <label class="form-label field-label mb-0" for="series-title">Nombre de la serie</label>
                        @if (!string.IsNullOrWhiteSpace(SelectedFile.SeriesTitle))
                        {
                            <button type="button" class="btn-apply-batch"
                                @onclick="() => OnApplySeriesTitleToAll.InvokeAsync(SelectedFile.SeriesTitle)"
                                title="Aplicar este nombre de serie a todos los archivos marcados">
                                Aplicar a todos
                            </button>
                        }
                    </div>
                    <input id="series-title" type="text" class="form-control" @bind="SelectedFile.SeriesTitle"
                        @bind:after="OnChanged" placeholder="Ej: Breaking Bad" />
                </div>

                <div class="field-grid">
                    <div class="field-group">
                        <div class="field-label-row">
                            <label class="form-label field-label mb-0" for="season-number">Temporada</label>
                            <button type="button" class="btn-apply-batch"
                                @onclick="() => OnApplySeasonToAll.InvokeAsync(SelectedFile.Season)"
                                title="Aplicar esta temporada a todos los archivos marcados">
                                A todos
                            </button>
                        </div>
                        <input id="season-number" type="number" class="form-control" @bind="SelectedFile.Season"
                            @bind:after="OnChanged" min="0" />
                    </div>
                    <div class="field-group">
                        <div class="field-label-row">
                            <label class="form-label field-label mb-0" for="episode-number">Episodio</label>
                            <button type="button" class="btn-apply-batch"
                                @onclick="() => OnRenumberFromEpisode.InvokeAsync(Math.Max(1, SelectedFile.Episode))"
                                title="Renumerar todos los archivos marcados secuencialmente desde este episodio">
                                Secuencial
                            </button>
                        </div>
                        <input id="episode-number" type="number" class="form-control" @bind="SelectedFile.Episode"
                            @bind:after="OnChanged" min="1" />
                    </div>
                </div>

                <div class="field-group">
                    <label class="form-label field-label" for="episode-title">Título del episodio</label>
                    <input id="episode-title" type="text" class="form-control" @bind="SelectedFile.EpisodeTitle"
                        @bind:after="OnChanged" placeholder="Ej: Pilot (opcional)" />
                </div>
            </section>
        }

        <section class="editor-card">
            <div class="editor-card-header">
                <span class="panel-kicker">Resultado</span>
                <h3 class="editor-card-title">Vista previa del nuevo nombre</h3>
            </div>

            @if (!string.IsNullOrEmpty(SelectedFile.NewName))
            {
                <div class="preview-card" aria-live="polite">
                    <span class="preview-label">Nombre generado</span>
                    <code class="preview-value">@SelectedFile.NewName</code>
                </div>
            }
            else
            {
                <div class="preview-card preview-card-muted">
                    <span class="preview-label">Aún no disponible</span>
                    <p class="mb-0">Completa los campos o ejecuta el análisis para preparar una propuesta de nombre.</p>
                </div>
            }
        </section>
    </div>
}

@code {
    [Parameter]
    public FileViewModel? SelectedFile { get; set; }

    [Parameter]
    public RenameMode SelectedMode { get; set; }

    [Parameter]
    public EventCallback OnChange { get; set; }

    [Parameter]
    public EventCallback<string> OnApplySeriesTitleToAll { get; set; }

    [Parameter]
    public EventCallback<int> OnApplySeasonToAll { get; set; }

    [Parameter]
    public EventCallback<int> OnRenumberFromEpisode { get; set; }

    private async Task OnChanged()
    {
        if (SelectedFile != null && SelectedFile.Status == FileStatus.Pending && !string.IsNullOrWhiteSpace(SelectedFile.SeriesTitle))
        {
            SelectedFile.Status = FileStatus.Analyzed;
        }
        await OnChange.InvokeAsync();
    }
}
