@using organizadorCapitulos.Core.Entities
@using OrganizadorCapitulos.Maui.Services
@using OrganizadorCapitulos.Maui.Services.Workflows
@using organizadorCapitulos.Core.Enums
@using System.Collections.ObjectModel
@using System.Threading
@inject organizadorCapitulos.Core.Interfaces.Services.IMetadataService MetadataService
@inject TmdbMatchingWorkflow MatchingWorkflow
@inject SettingsService Settings
@implements IDisposable

<div class="modal fade show d-block modal-backdrop-themed" tabindex="-1" role="dialog" aria-modal="true"
     aria-labelledby="tmdb-dialog-title">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="tmdb-dialog-title">
                    <Icon Name="database" Size="15" />
                    <span>Buscar metadatos en TMDB</span>
                    <span class="status-pill status-pending" style="font-family: var(--font-mono);">@Settings.TmdbLanguage</span>
                </h5>
                <button type="button" class="btn-close" data-shortcut="escape" @onclick="Cancel" aria-label="Cerrar diálogo"></button>
            </div>
            <div class="modal-body d-flex flex-column gap-3">
                @if (!IsConfigured)
                {
                    <div class="alert alert-warning mb-0" style="font-size: 12.5px;">
                        <strong>API Key requerida:</strong> Configura tu clave o token de TMDB en Preferencias para buscar metadatos.
                    </div>
                }
                else
                {
                    <!-- Search Type Segmented Switch -->
                    <div class="segmented-control" role="group" aria-label="Tipo de búsqueda" style="max-width: 260px;">
                        <button type="button" class="segmented-option @(!IsMovieSearchMode ? "active" : "")" @onclick="() => SetSearchMode(false)">
                            <Icon Name="tv" Size="13" />
                            <span>Series de TV</span>
                        </button>
                        <button type="button" class="segmented-option @(IsMovieSearchMode ? "active" : "")" @onclick="() => SetSearchMode(true)">
                            <Icon Name="film" Size="13" />
                            <span>Películas</span>
                        </button>
                    </div>

                    <!-- Search Input -->
                    <div class="d-flex gap-2">
                        <input type="text" class="form-control" @bind="SearchQuery" @bind:event="oninput"
                               @onkeypress="OnKeyPress"
                               placeholder="@(IsMovieSearchMode ? "Nombre de la película..." : "Nombre de la serie...")"
                               aria-label="Buscar en TMDB" />
                        <button type="button" class="cmd-btn cmd-btn-primary" @onclick="Search" disabled="@IsSearching" style="height: 32px;">
                            <Icon Name="search" Size="13" />
                            <span>@(IsSearching ? "Buscando..." : "Buscar")</span>
                        </button>
                    </div>

                    <!-- Search Results -->
                    @if (IsMovieSearchMode && MovieSearchResults.Any())
                    {
                        <div class="tmdb-results-list">
                            @foreach (var movie in MovieSearchResults)
                            {
                                <button type="button"
                                        class="tmdb-result-card @(SelectedMovie?.Id == movie.Id ? "active" : "")"
                                        @onclick="() => SelectMovie(movie)">
                                    @if (!string.IsNullOrEmpty(movie.PosterUrl))
                                    {
                                        <img src="@movie.PosterUrl" alt="@movie.Title" class="tmdb-poster" loading="lazy" />
                                    }
                                    else
                                    {
                                        <div class="tmdb-poster tmdb-poster-placeholder" aria-hidden="true">
                                            <Icon Name="film" Size="16" />
                                        </div>
                                    }
                                    <div class="tmdb-result-body">
                                        <div class="tmdb-result-header">
                                            <strong>@movie.Title</strong>
                                            @if (!string.IsNullOrEmpty(movie.ReleaseDate))
                                            {
                                                <span class="tmdb-year">@movie.ReleaseDate.Split('-')[0]</span>
                                            }
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(movie.Overview))
                                        {
                                            <p class="tmdb-overview">@movie.Overview</p>
                                        }
                                    </div>
                                </button>
                            }
                        </div>
                    }
                    else if (!IsMovieSearchMode && SearchResults.Any())
                    {
                        <div class="tmdb-results-list">
                            @foreach (var series in SearchResults)
                            {
                                <button type="button"
                                        class="tmdb-result-card @(SelectedSeries?.Id == series.Id ? "active" : "")"
                                        @onclick="() => SelectSeries(series)">
                                    @if (!string.IsNullOrEmpty(series.PosterUrl))
                                    {
                                        <img src="@series.PosterUrl" alt="@series.Name" class="tmdb-poster" loading="lazy" />
                                    }
                                    else
                                    {
                                        <div class="tmdb-poster tmdb-poster-placeholder" aria-hidden="true">
                                            <Icon Name="tv" Size="16" />
                                        </div>
                                    }
                                    <div class="tmdb-result-body">
                                        <div class="tmdb-result-header">
                                            <strong>@series.Name</strong>
                                            @if (!string.IsNullOrEmpty(series.FirstAirDate))
                                            {
                                                <span class="tmdb-year">@series.FirstAirDate.Split('-')[0]</span>
                                            }
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(series.Overview))
                                        {
                                            <p class="tmdb-overview">@series.Overview</p>
                                        }
                                    </div>
                                </button>
                            }
                        </div>
                    }

                    @if (!IsMovieSearchMode)
                    {
                        <div class="d-flex flex-column gap-1" style="font-size: 12.5px;">
                            <span class="field-label">Modo de emparejamiento</span>
                            <label class="form-check d-flex align-items-center gap-2 mb-0">
                                <input class="form-check-input mt-0" type="radio" name="fetchMode" id="modeTitleFetch"
                                       checked="@(!_lookupSeasonEpisode)"
                                       @onchange="() => _lookupSeasonEpisode = false" />
                                <span class="form-check-label">Obtener título del episodio (usa temporada/capítulo actuales)</span>
                            </label>
                            <label class="form-check d-flex align-items-center gap-2 mb-0">
                                <input class="form-check-input mt-0" type="radio" name="fetchMode" id="modeSeasonFetch"
                                       checked="@_lookupSeasonEpisode"
                                       @onchange="() => _lookupSeasonEpisode = true" />
                                <span class="form-check-label">Obtener temporada y capítulo (emparejamiento por título)</span>
                            </label>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(StatusMessage))
                    {
                        <div class="alert @(IsError ? "alert-danger" : (OperationFinished ? "alert-success" : "alert-info")) py-2 px-3 mb-0" style="font-size: 12px;">
                            @StatusMessage
                        </div>
                    }
                }
            </div>
            <div class="modal-footer d-flex justify-content-between">
                <div>
                    @if (IsFetching)
                    {
                        <button type="button" class="cmd-btn cmd-btn-danger-outline" @onclick="CancelFetch">
                            Cancelar descarga
                        </button>
                    }
                    else if (IsMovieSearchMode && IsConfigured && !OperationFinished)
                    {
                        <button type="button" class="cmd-btn" @onclick="AutoIdentifyMovies">
                            <Icon Name="sparkles" Size="13" />
                            <span>Auto-identificar lote</span>
                        </button>
                    }
                </div>

                <div class="d-flex gap-2">
                    @if (OperationFinished)
                    {
                        <button type="button" class="cmd-btn cmd-btn-primary" @onclick="Cancel">Cerrar y revisar</button>
                    }
                    else if (IsMovieSearchMode)
                    {
                        <button type="button" class="cmd-btn" @onclick="Cancel">Cancelar</button>
                        @if (SelectedFile != null)
                        {
                            <button type="button" class="cmd-btn" @onclick="ApplyToSelectedFile"
                                    disabled="@(SelectedMovie == null || IsFetching)">
                                Aplicar a seleccionado
                            </button>
                        }
                        <button type="button" class="cmd-btn cmd-btn-success" @onclick="ApplyToAllFiles"
                                disabled="@(SelectedMovie == null || IsFetching)">
                            Aplicar a marcados
                        </button>
                    }
                    else
                    {
                        <button type="button" class="cmd-btn" @onclick="Cancel">Cancelar</button>
                        <button type="button" class="cmd-btn cmd-btn-success" @onclick="FetchEpisodes"
                                disabled="@(SelectedSeries == null || IsFetching)">
                            @(IsFetching
                                ? "Procesando..."
                                : (_lookupSeasonEpisode ? "Obtener Temporada/Capítulo" : "Descargar títulos"))
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public ObservableCollection<OrganizadorCapitulos.Maui.Models.FileViewModel> Files { get; set; } = new();

    [Parameter]
    public RenameMode CurrentMode { get; set; } = RenameMode.Maintain;

    [Parameter]
    public OrganizadorCapitulos.Maui.Models.FileViewModel? SelectedFile { get; set; }

    [Parameter]
    public EventCallback<string> OnSeriesSelected { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private string SearchQuery = "";
    private List<SeriesSearchResult> SearchResults = new();
    private List<MovieSearchResult> MovieSearchResults = new();
    private SeriesSearchResult? SelectedSeries;
    private MovieSearchResult? SelectedMovie;
    private string StatusMessage = "";
    private bool IsError = false;
    private bool IsSearching = false;
    private bool IsFetching = false;
    private bool OperationFinished = false;
    private bool IsConfigured = false;
    private bool IsMovieSearchMode = false;
    private bool _lookupSeasonEpisode = false;
    private CancellationTokenSource? _fetchCts;
    private CancellationTokenSource? _searchCts;

    protected override void OnInitialized()
    {
        var apiKey = Settings.TmdbApiKey;
        if (!string.IsNullOrEmpty(apiKey))
        {
            MetadataService.Configure(apiKey);
        }
        MetadataService.ConfigureLanguage(Settings.TmdbLanguage);
        IsConfigured = MetadataService.IsConfigured();
        IsMovieSearchMode = CurrentMode == RenameMode.Movie;

        var candidateTitle = SelectedFile?.SeriesTitle ?? Files.FirstOrDefault(f => !string.IsNullOrWhiteSpace(f.SeriesTitle))?.SeriesTitle;
        if (!string.IsNullOrWhiteSpace(candidateTitle))
        {
            SearchQuery = candidateTitle;
        }
    }

    private void SetSearchMode(bool isMovie)
    {
        IsMovieSearchMode = isMovie;
        SearchResults.Clear();
        MovieSearchResults.Clear();
        SelectedSeries = null;
        SelectedMovie = null;
        StatusMessage = "";
        IsError = false;
        OperationFinished = false;
    }

    private async Task OnKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await Search();
        }
    }

    private async Task Search()
    {
        if (string.IsNullOrWhiteSpace(SearchQuery)) return;

        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = new CancellationTokenSource();
        var ct = _searchCts.Token;

        IsSearching = true;
        OperationFinished = false;
        StatusMessage = "";
        SearchResults.Clear();
        MovieSearchResults.Clear();
        SelectedSeries = null;
        SelectedMovie = null;
        StateHasChanged();

        try
        {
            if (IsMovieSearchMode)
            {
                MovieSearchResults = await MetadataService.SearchMoviesAsync(SearchQuery, ct);
                if (!MovieSearchResults.Any())
                {
                    StatusMessage = "No se encontraron películas.";
                    IsError = false;
                }
            }
            else
            {
                SearchResults = await MetadataService.SearchSeriesAsync(SearchQuery, ct);
                if (!SearchResults.Any())
                {
                    StatusMessage = "No se encontraron series de TV.";
                    IsError = false;
                }
            }
        }
        catch (OperationCanceledException)
        {
            // Superseded by newer search or dialog close
        }
        catch (Exception ex)
        {
            StatusMessage = $"Error: {ex.Message}";
            IsError = true;
        }
        finally
        {
            IsSearching = false;
        }
    }

    private void SelectSeries(SeriesSearchResult series)
    {
        SelectedSeries = series;
        OperationFinished = false;
        StatusMessage = $"Serie seleccionada: {series.Name}";
        IsError = false;
    }

    private void SelectMovie(MovieSearchResult movie)
    {
        SelectedMovie = movie;
        OperationFinished = false;
        StatusMessage = $"Película seleccionada: {movie.Title}";
        IsError = false;
    }

    private void CancelFetch()
    {
        _fetchCts?.Cancel();
    }

    private async Task ApplyToSelectedFile()
    {
        if (SelectedMovie == null || SelectedFile == null) return;

        SelectedFile.SeriesTitle = SelectedMovie.Title;
        if (int.TryParse(SelectedMovie.ReleaseDate?.Split('-')[0], out int year))
        {
            SelectedFile.Year = year;
        }
        SelectedFile.Status = FileStatus.Analyzed;

        StatusMessage = $"Película aplicada a {SelectedFile.OriginalName}.";
        IsError = false;
        OperationFinished = true;

        await OnSeriesSelected.InvokeAsync(SelectedMovie.Title);
    }

    private async Task ApplyToAllFiles()
    {
        if (SelectedMovie == null) return;

        var targets = Files.Where(f => f.IsChecked).ToList();
        foreach (var file in targets)
        {
            file.SeriesTitle = SelectedMovie.Title;
            if (int.TryParse(SelectedMovie.ReleaseDate?.Split('-')[0], out int year))
            {
                file.Year = year;
            }
            file.Status = FileStatus.Analyzed;
        }

        StatusMessage = $"Película aplicada a {targets.Count} archivo(s).";
        IsError = false;
        OperationFinished = true;

        await OnSeriesSelected.InvokeAsync(SelectedMovie.Title);
    }

    private async Task AutoIdentifyMovies()
    {
        _fetchCts?.Cancel();
        _fetchCts?.Dispose();
        _fetchCts = new CancellationTokenSource();
        var ct = _fetchCts.Token;

        IsFetching = true;
        OperationFinished = false;
        StatusMessage = "Auto-identificando películas...";
        IsError = false;
        StateHasChanged();

        try
        {
            var targets = Files.Where(f => f.IsChecked).ToList();
            var inputs = targets
                .Select((f, idx) => new MovieMatchInput(idx, f.OriginalName))
                .ToList();

            var outcomes = await MatchingWorkflow.AutoIdentifyMoviesAsync(
                inputs,
                (current, total, query) =>
                {
                    StatusMessage = $"Procesando [{current}/{total}]: {query}";
                    _ = InvokeAsync(StateHasChanged);
                },
                ct);

            foreach (var match in outcomes)
            {
                var file = targets[match.Index];
                file.SeriesTitle = match.Title;
                file.Year = match.Year;
                file.Status = FileStatus.Analyzed;
            }

            int total = targets.Count;
            int found = outcomes.Count;
            StatusMessage = $"Completado: {found} de {total} películas identificadas ({total - found} sin coincidencia).";
            OperationFinished = true;
            await OnSeriesSelected.InvokeAsync("Lote de películas");
        }
        catch (OperationCanceledException)
        {
            StatusMessage = "Identificación cancelada por el usuario.";
            IsError = false;
        }
        catch (Exception ex)
        {
            StatusMessage = $"Error: {ex.Message}";
            IsError = true;
        }
        finally
        {
            IsFetching = false;
        }
    }

    private async Task FetchEpisodes()
    {
        if (SelectedSeries == null) return;

        _fetchCts?.Cancel();
        _fetchCts?.Dispose();
        _fetchCts = new CancellationTokenSource();
        var ct = _fetchCts.Token;

        IsFetching = true;
        OperationFinished = false;
        StatusMessage = _lookupSeasonEpisode
            ? "Descargando catálogo de episodios y emparejando..."
            : "Descargando títulos de episodios...";
        StateHasChanged();

        try
        {
            var targets = Files.Where(f => f.IsChecked).ToList();
            var inputs = targets
                .Select((f, idx) => new EpisodeMatchInput(idx, f.OriginalName, f.Season, f.Episode, f.EpisodeTitle))
                .ToList();

            var outcomes = await MatchingWorkflow.FetchEpisodesAsync(
                SelectedSeries.Id,
                _lookupSeasonEpisode,
                inputs,
                (current, total, fileName) =>
                {
                    StatusMessage = $"Procesando [{current}/{total}]: {fileName}";
                    _ = InvokeAsync(StateHasChanged);
                },
                ct);

            foreach (var match in outcomes)
            {
                var file = targets[match.Index];
                file.Season = match.Season;
                file.Episode = match.Episode;
                file.EpisodeTitle = match.EpisodeTitle;
                file.SeriesTitle = SelectedSeries.Name ?? "";
                file.Status = FileStatus.Analyzed;
            }

            int total = targets.Count;
            int found = outcomes.Count;
            StatusMessage = $"Completado: {found} de {total} archivos actualizados ({total - found} sin coincidencia).";
            IsError = false;
            OperationFinished = true;

            if (SelectedSeries.Name != null)
            {
                await OnSeriesSelected.InvokeAsync(SelectedSeries.Name);
            }
        }
        catch (OperationCanceledException)
        {
            StatusMessage = "Descarga cancelada por el usuario.";
            IsError = false;
        }
        catch (Exception ex)
        {
            StatusMessage = $"Error: {ex.Message}";
            IsError = true;
        }
        finally
        {
            IsFetching = false;
        }
    }

    private async Task Cancel()
    {
        _searchCts?.Cancel();
        _fetchCts?.Cancel();
        await OnClose.InvokeAsync();
    }

    public void Dispose()
    {
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _fetchCts?.Cancel();
        _fetchCts?.Dispose();
    }
}
