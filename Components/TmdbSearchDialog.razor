@using organizadorCapitulos.Core.Entities
@using organizadorCapitulos.Application.Services
@using OrganizadorCapitulos.Maui.Services
@using organizadorCapitulos.Core.Enums
@using System.Collections.ObjectModel
@using System.Threading
@inject organizadorCapitulos.Core.Interfaces.Services.IMetadataService MetadataService
@inject SettingsService Settings
@implements IDisposable

<div class="modal fade show d-block modal-backdrop-themed" tabindex="-1" role="dialog" aria-modal="true"
    aria-labelledby="tmdb-dialog-title">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header py-2">
                <div class="modal-title-group">
                    <span class="modal-kicker">Catálogo TMDB (@Settings.TmdbLanguage)</span>
                    <h5 class="modal-title" id="tmdb-dialog-title">Buscar metadatos en TMDB</h5>
                    <p class="modal-subtitle">
                        @(IsMovieSearchMode
                            ? "Busca películas o identifícalas en lote, y descarga títulos y años oficiales."
                            : "Busca la serie correcta y descarga títulos o numeración oficial para los archivos marcados.")
                    </p>
                </div>
                <button type="button" class="btn-close" data-shortcut="escape" @onclick="Cancel" aria-label="Cerrar diálogo"></button>
            </div>
            <div class="modal-body">
                @if (!IsConfigured)
                {
                    <div class="alert alert-warning mb-0">
                        <strong>Configuración requerida:</strong> Por favor configura tu API Key o Token de TMDB en Configuración.
                    </div>
                }
                else
                {
                    <!-- Search Type Selector -->
                    <div class="d-flex justify-content-center mb-3">
                        <div class="btn-group btn-group-sm" role="group" aria-label="Tipo de búsqueda">
                            <button type="button" class="btn @(IsMovieSearchMode ? "btn-outline-primary" : "btn-primary")" @onclick="() => SetSearchMode(false)">
                                Series de TV
                            </button>
                            <button type="button" class="btn @(IsMovieSearchMode ? "btn-primary" : "btn-outline-primary")" @onclick="() => SetSearchMode(true)">
                                Películas
                            </button>
                        </div>
                    </div>

                    <!-- Search Input -->
                    <div class="input-group mb-3">
                        <input type="text" class="form-control" @bind="SearchQuery" @bind:event="oninput"
                            @onkeypress="OnKeyPress"
                            placeholder="@(IsMovieSearchMode ? "Nombre de la película..." : "Nombre de la serie...")"
                            aria-label="Buscar en TMDB" />
                        <button class="btn btn-primary" @onclick="Search" disabled="@IsSearching" aria-label="Ejecutar búsqueda en TMDB">
                            @(IsSearching ? "Buscando..." : "Buscar")
                        </button>
                    </div>

                    <!-- Search Results with Poster & Overview -->
                    @if (IsMovieSearchMode && MovieSearchResults.Any())
                    {
                        <div class="tmdb-results-list mb-3">
                            @foreach (var movie in MovieSearchResults)
                            {
                                <button type="button"
                                    class="tmdb-result-card @(SelectedMovie?.Id == movie.Id ? "active" : "")"
                                    @onclick="() => SelectMovie(movie)">
                                    @if (!string.IsNullOrEmpty(movie.PosterUrl))
                                    {
                                        <img src="@movie.PosterUrl" alt="@movie.Title" class="tmdb-poster" loading="lazy" />
                                    }
                                    else
                                    {
                                        <div class="tmdb-poster tmdb-poster-placeholder" aria-hidden="true">🎬</div>
                                    }
                                    <div class="tmdb-result-body">
                                        <div class="tmdb-result-header">
                                            <strong>@movie.Title</strong>
                                            @if (!string.IsNullOrEmpty(movie.ReleaseDate))
                                            {
                                                <span class="tmdb-year">@movie.ReleaseDate.Split('-')[0]</span>
                                            }
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(movie.Overview))
                                        {
                                            <p class="tmdb-overview">@movie.Overview</p>
                                        }
                                    </div>
                                </button>
                            }
                        </div>
                    }
                    else if (!IsMovieSearchMode && SearchResults.Any())
                    {
                        <div class="tmdb-results-list mb-3">
                            @foreach (var series in SearchResults)
                            {
                                <button type="button"
                                    class="tmdb-result-card @(SelectedSeries?.Id == series.Id ? "active" : "")"
                                    @onclick="() => SelectSeries(series)">
                                    @if (!string.IsNullOrEmpty(series.PosterUrl))
                                    {
                                        <img src="@series.PosterUrl" alt="@series.Name" class="tmdb-poster" loading="lazy" />
                                    }
                                    else
                                    {
                                        <div class="tmdb-poster tmdb-poster-placeholder" aria-hidden="true">📺</div>
                                    }
                                    <div class="tmdb-result-body">
                                        <div class="tmdb-result-header">
                                            <strong>@series.Name</strong>
                                            @if (!string.IsNullOrEmpty(series.FirstAirDate))
                                            {
                                                <span class="tmdb-year">@series.FirstAirDate.Split('-')[0]</span>
                                            }
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(series.Overview))
                                        {
                                            <p class="tmdb-overview">@series.Overview</p>
                                        }
                                    </div>
                                </button>
                            }
                        </div>
                    }

                    @if (!IsMovieSearchMode)
                    {
                        <div class="mb-3">
                            <p class="form-label field-label mb-1">Modo de emparejamiento</p>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="fetchMode" id="modeTitleFetch"
                                    checked="@(!_lookupSeasonEpisode)"
                                    @onchange="() => _lookupSeasonEpisode = false" />
                                <label class="form-check-label" for="modeTitleFetch">
                                    Obtener <strong>título del episodio</strong> (usa temporada/capítulo del nombre del archivo)
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="fetchMode" id="modeSeasonFetch"
                                    checked="@_lookupSeasonEpisode"
                                    @onchange="() => _lookupSeasonEpisode = true" />
                                <label class="form-check-label" for="modeSeasonFetch">
                                    Obtener <strong>temporada y capítulo</strong> (búsqueda aproximada por título del episodio)
                                </label>
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(StatusMessage))
                    {
                        <div class="alert @(IsError ? "alert-danger" : (OperationFinished ? "alert-success" : "alert-info")) py-2 small mb-0">
                            @StatusMessage
                        </div>
                    }
                }
            </div>
            <div class="modal-footer py-2">
                @if (IsFetching)
                {
                    <button type="button" class="btn btn-outline-danger btn-sm me-auto" @onclick="CancelFetch">
                        Cancelar descarga
                    </button>
                }
                else if (IsMovieSearchMode && IsConfigured)
                {
                    <button type="button" class="btn btn-info btn-sm me-auto" @onclick="AutoIdentifyMovies">
                        Auto-identificar lote
                    </button>
                }

                @if (OperationFinished)
                {
                    <button type="button" class="btn btn-primary btn-sm" @onclick="Cancel">Cerrar y revisar</button>
                }
                else if (IsMovieSearchMode)
                {
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="Cancel">Cancelar</button>
                    @if (SelectedFile != null)
                    {
                        <button type="button" class="btn btn-primary btn-sm" @onclick="ApplyToSelectedFile"
                            disabled="@(SelectedMovie == null || IsFetching)">
                            Aplicar a selec.
                        </button>
                    }
                    <button type="button" class="btn btn-success btn-sm" @onclick="ApplyToAllFiles"
                        disabled="@(SelectedMovie == null || IsFetching)">
                        Aplicar a marcados
                    </button>
                }
                else
                {
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="Cancel">Cancelar</button>
                    <button type="button" class="btn btn-success btn-sm" @onclick="FetchEpisodes"
                        disabled="@(SelectedSeries == null || IsFetching)">
                        @(IsFetching
                            ? "Procesando..."
                            : (_lookupSeasonEpisode ? "Obtener Temporada/Capítulo" : "Descargar Títulos"))
                    </button>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public ObservableCollection<OrganizadorCapitulos.Maui.Models.FileViewModel> Files { get; set; } = new();

    [Parameter]
    public RenameMode CurrentMode { get; set; } = RenameMode.Maintain;

    [Parameter]
    public OrganizadorCapitulos.Maui.Models.FileViewModel? SelectedFile { get; set; }

    [Parameter]
    public EventCallback<string> OnSeriesSelected { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private string SearchQuery = "";
    private List<SeriesSearchResult> SearchResults = new();
    private List<MovieSearchResult> MovieSearchResults = new();
    private SeriesSearchResult? SelectedSeries;
    private MovieSearchResult? SelectedMovie;
    private string StatusMessage = "";
    private bool IsError = false;
    private bool IsSearching = false;
    private bool IsFetching = false;
    private bool OperationFinished = false;
    private bool IsConfigured = false;
    private bool IsMovieSearchMode = false;
    private bool _lookupSeasonEpisode = false;
    private CancellationTokenSource? _fetchCts;

    protected override void OnInitialized()
    {
        var apiKey = Settings.TmdbApiKey;
        if (!string.IsNullOrEmpty(apiKey))
        {
            MetadataService.Configure(apiKey);
        }
        MetadataService.ConfigureLanguage(Settings.TmdbLanguage);
        IsConfigured = MetadataService.IsConfigured();
        IsMovieSearchMode = CurrentMode == RenameMode.Movie;

        // Pre-fill search box from selected file or first analyzed file
        var candidateTitle = SelectedFile?.SeriesTitle ?? Files.FirstOrDefault(f => !string.IsNullOrWhiteSpace(f.SeriesTitle))?.SeriesTitle;
        if (!string.IsNullOrWhiteSpace(candidateTitle))
        {
            SearchQuery = candidateTitle;
        }
    }

    private void SetSearchMode(bool isMovie)
    {
        IsMovieSearchMode = isMovie;
        SearchResults.Clear();
        MovieSearchResults.Clear();
        SelectedSeries = null;
        SelectedMovie = null;
        StatusMessage = "";
        IsError = false;
        OperationFinished = false;
    }

    private async Task OnKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await Search();
        }
    }

    private async Task Search()
    {
        if (string.IsNullOrWhiteSpace(SearchQuery)) return;

        IsSearching = true;
        OperationFinished = false;
        StatusMessage = "";
        SearchResults.Clear();
        MovieSearchResults.Clear();
        SelectedSeries = null;
        SelectedMovie = null;
        StateHasChanged();

        try
        {
            if (IsMovieSearchMode)
            {
                MovieSearchResults = await MetadataService.SearchMoviesAsync(SearchQuery);
                if (!MovieSearchResults.Any())
                {
                    StatusMessage = "No se encontraron películas";
                    IsError = false;
                }
            }
            else
            {
                SearchResults = await MetadataService.SearchSeriesAsync(SearchQuery);
                if (!SearchResults.Any())
                {
                    StatusMessage = "No se encontraron series de TV";
                    IsError = false;
                }
            }
        }
        catch (Exception ex)
        {
            StatusMessage = $"Error: {ex.Message}";
            IsError = true;
        }
        finally
        {
            IsSearching = false;
        }
    }

    private void SelectSeries(SeriesSearchResult series)
    {
        SelectedSeries = series;
        OperationFinished = false;
        StatusMessage = $"Serie seleccionada: {series.Name}";
        IsError = false;
    }

    private void SelectMovie(MovieSearchResult movie)
    {
        SelectedMovie = movie;
        OperationFinished = false;
        StatusMessage = $"Película seleccionada: {movie.Title}";
        IsError = false;
    }

    private void CancelFetch()
    {
        _fetchCts?.Cancel();
    }

    private async Task ApplyToSelectedFile()
    {
        if (SelectedMovie == null || SelectedFile == null) return;

        SelectedFile.SeriesTitle = SelectedMovie.Title;
        if (int.TryParse(SelectedMovie.ReleaseDate?.Split('-')[0], out int year))
        {
            SelectedFile.Year = year;
        }
        SelectedFile.Status = FileStatus.Analyzed;

        StatusMessage = $"Película aplicada a {SelectedFile.OriginalName}.";
        IsError = false;
        OperationFinished = true;

        await OnSeriesSelected.InvokeAsync(SelectedMovie.Title);
    }

    private async Task ApplyToAllFiles()
    {
        if (SelectedMovie == null) return;

        var targets = Files.Where(f => f.IsChecked).ToList();
        foreach (var file in targets)
        {
            file.SeriesTitle = SelectedMovie.Title;
            if (int.TryParse(SelectedMovie.ReleaseDate?.Split('-')[0], out int year))
            {
                file.Year = year;
            }
            file.Status = FileStatus.Analyzed;
        }

        StatusMessage = $"Película aplicada a {targets.Count} archivo(s).";
        IsError = false;
        OperationFinished = true;

        await OnSeriesSelected.InvokeAsync(SelectedMovie.Title);
    }

    private async Task AutoIdentifyMovies()
    {
        _fetchCts?.Cancel();
        _fetchCts?.Dispose();
        _fetchCts = new CancellationTokenSource();
        var ct = _fetchCts.Token;

        IsFetching = true;
        OperationFinished = false;
        StatusMessage = "Auto-identificando películas...";
        IsError = false;
        StateHasChanged();

        try
        {
            var targets = Files.Where(f => f.IsChecked).ToList();
            int total = targets.Count;
            int current = 0;
            int found = 0;

            foreach (var file in targets)
            {
                ct.ThrowIfCancellationRequested();
                current++;
                StatusMessage = $"Procesando [{current}/{total}]: {file.OriginalName}";
                StateHasChanged();

                string queryTitle = EpisodePatternParser.ExtractMovieTitle(file.OriginalName);
                if (string.IsNullOrWhiteSpace(queryTitle)) continue;

                var results = await MetadataService.SearchMoviesAsync(queryTitle, ct);
                if (results != null && results.Any())
                {
                    var bestMatch = results.First();
                    file.SeriesTitle = bestMatch.Title;

                    if (int.TryParse(bestMatch.ReleaseDate?.Split('-')[0], out int year))
                    {
                        file.Year = year;
                    }
                    else
                    {
                        EpisodePatternParser.TryExtractYear(file.OriginalName, out int localYear);
                        file.Year = localYear;
                    }

                    file.Status = FileStatus.Analyzed;
                    found++;
                }
            }

            StatusMessage = $"Completado: {found} películas identificadas de {total} archivos ({total - found} sin coincidencia).";
            OperationFinished = true;
            await OnSeriesSelected.InvokeAsync("Lote de películas");
        }
        catch (OperationCanceledException)
        {
            StatusMessage = "Identificación cancelada por el usuario.";
            IsError = false;
        }
        catch (Exception ex)
        {
            StatusMessage = $"Error: {ex.Message}";
            IsError = true;
        }
        finally
        {
            IsFetching = false;
        }
    }

    private async Task FetchEpisodes()
    {
        if (SelectedSeries == null) return;

        _fetchCts?.Cancel();
        _fetchCts?.Dispose();
        _fetchCts = new CancellationTokenSource();
        var ct = _fetchCts.Token;

        IsFetching = true;
        OperationFinished = false;
        StatusMessage = _lookupSeasonEpisode
            ? "Descargando catálogo de episodios y emparejando..."
            : "Descargando títulos de episodios...";
        StateHasChanged();

        try
        {
            var targets = Files.Where(f => f.IsChecked).ToList();
            int total = targets.Count;
            int current = 0;
            int found = 0;

            foreach (var file in targets)
            {
                ct.ThrowIfCancellationRequested();
                current++;
                StatusMessage = $"Procesando [{current}/{total}]: {file.OriginalName}";
                StateHasChanged();

                if (_lookupSeasonEpisode)
                {
                    bool foundEpisode = false;

                    if (!string.IsNullOrEmpty(file.EpisodeTitle))
                    {
                        var result = await MetadataService.FindEpisodeByTitleAsync(SelectedSeries.Id, file.EpisodeTitle, ct);
                        if (result.HasValue)
                        {
                            file.Season = result.Value.season;
                            file.Episode = result.Value.episode;
                            file.EpisodeTitle = result.Value.title;
                            file.SeriesTitle = SelectedSeries.Name ?? "";
                            file.Status = FileStatus.Analyzed;
                            found++;
                            foundEpisode = true;
                        }
                    }

                    if (!foundEpisode)
                    {
                        string possibleTitle = EpisodePatternParser.ExtractPossibleTitle(file.OriginalName);
                        if (!string.IsNullOrEmpty(possibleTitle))
                        {
                            var result = await MetadataService.FindEpisodeByTitleAsync(SelectedSeries.Id, possibleTitle, ct);
                            if (result.HasValue)
                            {
                                file.Season = result.Value.season;
                                file.Episode = result.Value.episode;
                                file.EpisodeTitle = result.Value.title;
                                file.SeriesTitle = SelectedSeries.Name ?? "";
                                file.Status = FileStatus.Analyzed;
                                found++;
                            }
                        }
                    }
                }
                else
                {
                    int season = file.Season;
                    int episode = file.Episode;
                    bool hasNumbers = season > 0 && episode > 0;
                    if (!hasNumbers)
                    {
                        hasNumbers = EpisodePatternParser.TryExtractSeasonEpisode(file.OriginalName, out season, out episode);
                    }

                    if (hasNumbers)
                    {
                        var title = await MetadataService.GetEpisodeTitleAsync(SelectedSeries.Id, season, episode, ct);
                        if (!string.IsNullOrEmpty(title))
                        {
                            file.EpisodeTitle = title;
                            file.Season = season;
                            file.Episode = episode;
                            file.SeriesTitle = SelectedSeries.Name ?? "";
                            file.Status = FileStatus.Analyzed;
                            found++;
                        }
                    }
                }
            }

            StatusMessage = $"Completado: {found} de {total} archivos actualizados ({total - found} sin coincidencia).";
            IsError = false;
            OperationFinished = true;

            if (SelectedSeries.Name != null)
            {
                await OnSeriesSelected.InvokeAsync(SelectedSeries.Name);
            }
        }
        catch (OperationCanceledException)
        {
            StatusMessage = "Descarga cancelada por el usuario.";
            IsError = false;
        }
        catch (Exception ex)
        {
            StatusMessage = $"Error: {ex.Message}";
            IsError = true;
        }
        finally
        {
            IsFetching = false;
        }
    }

    private async Task Cancel()
    {
        _fetchCts?.Cancel();
        await OnClose.InvokeAsync();
    }

    public void Dispose()
    {
        _fetchCts?.Cancel();
        _fetchCts?.Dispose();
    }
}
