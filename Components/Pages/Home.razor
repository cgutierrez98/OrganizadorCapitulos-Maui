@page "/"
@using OrganizadorCapitulos.Maui.Components
@using OrganizadorCapitulos.Maui.ViewModels
@using organizadorCapitulos.Core.Enums
@using OrganizadorCapitulos.Maui.Services.Interfaces
@using System.ComponentModel
@using System.Threading
@inject HomeViewModel ViewModel
@inject Microsoft.JSInterop.IJSRuntime JS
@implements IDisposable

<div class="app-shell" @ondragover="HandleDragOver" @ondragover:preventDefault="true"
     @ondrop="HandleDrop" @ondrop:preventDefault="true" @ondragleave="HandleDragLeave">

    @if (ViewModel.IsDragging)
    {
        <div class="drop-zone-overlay">
            <div class="drop-zone-card">
                <Icon Name="folder-open" Size="28" />
                <strong>Soltar carpetas o sesión .json</strong>
                <span>Carga archivos de video o restaura una sesión exportada.</span>
            </div>
        </div>
    }

    <!-- Top Command Bar -->
    <header class="command-bar" aria-label="Barra de comandos">
        <div class="command-bar-left">
            <div class="app-brand">
                <Icon Name="film" Size="16" />
                <span>Organizador</span>
            </div>

            <div class="toolbar-sep" aria-hidden="true"></div>

            <button type="button"
                    class="cmd-btn @(!ViewModel.Files.Any() ? "cmd-btn-primary" : "")"
                    @onclick="() => ViewModel.ShowFolderBrowserCommand.Execute(null)"
                    aria-label="Abrir carpetas"
                    data-shortcut="ctrl+o"
                    title="Abrir carpetas (Ctrl+O)">
                <Icon Name="folder-open" Size="14" />
                <span>Abrir</span>
            </button>

            <button type="button"
                    class="cmd-btn"
                    @onclick="() => ViewModel.AnalyzeWithAICommand.Execute(null)"
                    disabled="@(!ViewModel.Files.Any() || ViewModel.IsProcessing)"
                    aria-label="Analizar nombres de archivo"
                    data-shortcut="ctrl+i"
                    title="Analizar nombres de archivo (Ctrl+I)">
                <Icon Name="sparkles" Size="14" />
                <span>Analizar</span>
            </button>

            <button type="button"
                    class="cmd-btn"
                    @onclick="() => ViewModel.OpenTmdbSearchCommand.Execute(null)"
                    disabled="@(!ViewModel.Files.Any() || ViewModel.IsProcessing)"
                    aria-label="Buscar metadatos en TMDB"
                    data-shortcut="ctrl+t"
                    title="Buscar en TMDB (Ctrl+T)">
                <Icon Name="database" Size="14" />
                <span>TMDB</span>
            </button>

            <button type="button"
                    class="cmd-btn"
                    @onclick="() => ViewModel.OpenSaveAllCommand.Execute(null)"
                    disabled="@(!ViewModel.Files.Any() || ViewModel.IsProcessing)"
                    aria-label="Mover archivos a otra carpeta"
                    data-shortcut="ctrl+m"
                    title="Mover archivos (Ctrl+M)">
                <Icon Name="folder-output" Size="14" />
                <span>Mover</span>
            </button>
        </div>

        <div class="command-bar-right">
            @{
                var readyCheckedCount = ViewModel.ReadyCheckedCount;
            }
            <button type="button"
                    class="cmd-btn cmd-btn-success"
                    @onclick="() => ViewModel.RenameAllCommand.Execute(null)"
                    disabled="@(readyCheckedCount == 0 || ViewModel.IsProcessing)"
                    aria-label="Renombrar archivos listos"
                    data-shortcut="ctrl+enter"
                    title="Renombrar todo (Ctrl+Enter)">
                <Icon Name="check" Size="14" />
                <span>Renombrar (@readyCheckedCount)</span>
            </button>

            <div class="toolbar-sep" aria-hidden="true"></div>

            <button type="button"
                    class="cmd-btn-ghost @(ViewModel.UndoRedo.UndoCount > 0 ? "" : "cmd-icon-btn")"
                    @onclick="() => ViewModel.UndoCommand.Execute(null)"
                    disabled="@(!ViewModel.UndoRedo.CanUndo || ViewModel.IsProcessing)"
                    aria-label="Deshacer último lote (Ctrl+Z)"
                    data-shortcut="ctrl+z"
                    title="Deshacer (@ViewModel.UndoRedo.UndoCount) (Ctrl+Z)">
                <Icon Name="undo" Size="14" />
                @if (ViewModel.UndoRedo.UndoCount > 0)
                {
                    <span class="cmd-badge-count">@ViewModel.UndoRedo.UndoCount</span>
                }
            </button>

            <button type="button"
                    class="cmd-btn-ghost @(ViewModel.UndoRedo.RedoCount > 0 ? "" : "cmd-icon-btn")"
                    @onclick="() => ViewModel.RedoCommand.Execute(null)"
                    disabled="@(!ViewModel.UndoRedo.CanRedo || ViewModel.IsProcessing)"
                    aria-label="Rehacer último lote (Ctrl+Y)"
                    data-shortcut="ctrl+y"
                    title="Rehacer (@ViewModel.UndoRedo.RedoCount) (Ctrl+Y)">
                <Icon Name="redo" Size="14" />
                @if (ViewModel.UndoRedo.RedoCount > 0)
                {
                    <span class="cmd-badge-count">@ViewModel.UndoRedo.RedoCount</span>
                }
            </button>

            <button type="button"
                    class="cmd-btn-ghost cmd-icon-btn"
                    @onclick="() => ViewModel.OpenOperationLogCommand.Execute(null)"
                    aria-label="Historial de operaciones"
                    data-shortcut="ctrl+h"
                    title="Historial (Ctrl+H)">
                <Icon Name="history" Size="15" />
            </button>

            <div class="cmd-dropdown">
                <button type="button"
                        class="cmd-btn-ghost cmd-icon-btn"
                        @onclick="() => showMoreMenu = !showMoreMenu"
                        title="Más acciones"
                        aria-label="Menú de acciones"
                        aria-haspopup="true"
                        aria-expanded="@showMoreMenu">
                    <Icon Name="more-horizontal" Size="15" />
                </button>
                @if (showMoreMenu)
                {
                    <div class="dropdown-backdrop" @onclick="() => showMoreMenu = false"></div>
                    <div class="cmd-dropdown-menu" role="menu" @onclick="() => showMoreMenu = false">
                        <button type="button" class="cmd-dropdown-item" role="menuitem"
                                disabled="@(ViewModel.ErrorCount == 0)"
                                @onclick="() => ViewModel.ClearErrorsCommand.Execute(null)">
                            <Icon Name="trash" Size="14" />
                            <span>Limpiar incidencias</span>
                        </button>
                        <button type="button" class="cmd-dropdown-item" role="menuitem"
                                disabled="@(!ViewModel.UndoRedo.CanUndo || ViewModel.IsProcessing)"
                                @onclick="() => ViewModel.UndoAllCommand.Execute(null)">
                            <Icon Name="undo" Size="14" />
                            <span>Deshacer todo (@ViewModel.UndoRedo.UndoCount)</span>
                        </button>
                        <div class="cmd-dropdown-sep"></div>
                        <button type="button" class="cmd-dropdown-item" role="menuitem"
                                @onclick="() => ViewModel.ExportSessionCommand.Execute(null)"
                                disabled="@(!ViewModel.Files.Any())">
                            <Icon Name="download" Size="14" />
                            <span>Exportar sesión (.json)</span>
                        </button>
                        <button type="button" class="cmd-dropdown-item" role="menuitem"
                                @onclick="() => ViewModel.ShowImportSessionCommand.Execute(null)">
                            <Icon Name="upload" Size="14" />
                            <span>Importar sesión (.json)</span>
                        </button>
                        <div class="cmd-dropdown-sep"></div>
                        <button type="button" class="cmd-dropdown-item" role="menuitem"
                                @onclick="() => showShortcutsTooltip = true">
                            <Icon Name="keyboard" Size="14" />
                            <span>Atajos de teclado</span>
                        </button>
                    </div>
                }
            </div>

            <button type="button"
                    class="cmd-btn-ghost cmd-icon-btn"
                    @onclick="async () => { await ViewModel.ThemeService.ToggleThemeAsync(); await InvokeAsync(StateHasChanged); }"
                    title="Cambiar tema (Ctrl+D)"
                    aria-label="@(ViewModel.ThemeService.IsDarkTheme ? "Cambiar a tema claro" : "Cambiar a tema oscuro")"
                    data-shortcut="ctrl+d">
                <Icon Name="@(ViewModel.ThemeService.IsDarkTheme ? "sun" : "moon")" Size="15" />
            </button>

            <button type="button"
                    class="cmd-btn-ghost cmd-icon-btn"
                    @onclick="() => ViewModel.OpenSettingsCommand.Execute(null)"
                    aria-label="Configuración"
                    data-shortcut="ctrl+comma"
                    title="Configuración (Ctrl+,)">
                <Icon Name="settings" Size="15" />
            </button>
        </div>
    </header>

    <!-- Progress Strip -->
    @if (ViewModel.IsProcessing)
    {
        <div class="progress-strip" aria-live="polite">
            <span class="progress-strip-text">@ViewModel.ProgressMessage</span>
            <div class="progress-strip-track">
                <div class="progress-strip-fill" style="width: @ViewModel.ProgressPercent%"></div>
            </div>
            <span class="progress-strip-counts">@ViewModel.ProgressCurrent / @ViewModel.ProgressTotal</span>
            <button type="button"
                    class="cmd-btn cmd-btn-danger-outline"
                    style="height: 24px; padding: 0 8px; font-size: 11.5px;"
                    @onclick="() => ViewModel.CancelOperationCommand.Execute(null)">
                Cancelar
            </button>
        </div>
    }

    <!-- Master–Detail Workspace -->
    <main class="workspace-split">
        <section class="workspace-main" aria-label="Lista de archivos">
            <FileList Files="@ViewModel.Files"
                      OnFileSelected="@((f) => ViewModel.SelectFileCommand.Execute(f))"
                      OnToggleAllChecked="@((chk) => ViewModel.ToggleAllCheckedCommand.Execute(chk))"
                      OnCheckChanged="@(() => StateHasChanged())"
                      OnOpenFolders="@(() => ViewModel.ShowFolderBrowserCommand.Execute(null))" />
        </section>

        <aside class="workspace-inspector" aria-label="Inspector de archivo">
            <div class="inspector-header">
                <StrategySelector SelectedMode="@ViewModel.CurrentMode"
                                  OnModeChanged="@((m) => ViewModel.ChangeModeCommand.Execute(m))" />
            </div>

            <div class="inspector-scroll">
                <DetailsForm SelectedFile="@ViewModel.SelectedFile"
                             SelectedMode="@ViewModel.CurrentMode"
                             IsProcessing="@ViewModel.IsProcessing"
                             OnChange="@(() => ViewModel.UpdatePreviewForFileCommand.Execute(null))"
                             OnRenameSelected="@(() => ViewModel.RenameSelectedCommand.Execute(null))"
                             OnApplySeriesTitleToAll="@((t) => ViewModel.ApplySeriesTitleToAllCommand.Execute(t))"
                             OnApplySeasonToAll="@((s) => ViewModel.ApplySeasonToAllCommand.Execute(s))"
                             OnRenumberFromEpisode="@((ep) => ViewModel.RenumberEpisodesSequentiallyCommand.Execute(ep))" />
            </div>
        </aside>
    </main>

    <!-- Bottom Status Bar -->
    <footer class="app-statusbar" aria-live="polite">
        <div class="statusbar-left">
            <span class="status-dot" style="background: @(ViewModel.ErrorCount > 0 ? "var(--danger)" : ViewModel.IsProcessing ? "var(--accent)" : "var(--success)");"></span>
            <span class="statusbar-msg">@ViewModel.StatusMessage</span>
        </div>

        <div class="statusbar-right">
            @if (ViewModel.Files.Count > 0)
            {
                <span>@ViewModel.Files.Count archivos · @ViewModel.AnalyzedCount listos · @ViewModel.PendingCount pendientes</span>
                @if (ViewModel.ErrorCount > 0)
                {
                    <span style="color: var(--danger);">· @ViewModel.ErrorCount errores</span>
                }
            }
            <button type="button"
                    class="statusbar-link"
                    @onclick="() => showShortcutsTooltip = !showShortcutsTooltip"
                    data-shortcut="?"
                    aria-label="Ver atajos de teclado"
                    title="Atajos de teclado (?)">
                <Icon Name="keyboard" Size="12" />
                <span>Atajos</span>
            </button>
        </div>
    </footer>
</div>

@* Keyboard Shortcuts Modal *@
@if (showShortcutsTooltip)
{
    <div class="modal-backdrop fade show modal-backdrop-themed" aria-hidden="true" @onclick="() => showShortcutsTooltip = false"></div>
    <div class="modal d-block" tabindex="-1" role="dialog" aria-labelledby="shortcuts-title" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="shortcuts-title">
                        <Icon Name="keyboard" Size="15" />
                        <span>Atajos de teclado</span>
                    </h5>
                    <button type="button" class="btn-close" data-shortcut="escape" @onclick="() => showShortcutsTooltip = false" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div class="shortcuts-grid">
                        <div class="shortcut-row"><span>Abrir carpetas</span><kbd>Ctrl+O</kbd></div>
                        <div class="shortcut-row"><span>Analizar archivos</span><kbd>Ctrl+I</kbd></div>
                        <div class="shortcut-row"><span>Buscar en TMDB</span><kbd>Ctrl+T</kbd></div>
                        <div class="shortcut-row"><span>Renombrar listos</span><kbd>Ctrl+Enter</kbd></div>
                        <div class="shortcut-row"><span>Renombrar seleccionado</span><kbd>F2</kbd></div>
                        <div class="shortcut-row"><span>Mover archivos</span><kbd>Ctrl+M</kbd></div>
                        <div class="shortcut-row"><span>Deshacer lote</span><kbd>Ctrl+Z</kbd></div>
                        <div class="shortcut-row"><span>Rehacer lote</span><kbd>Ctrl+Y</kbd></div>
                        <div class="shortcut-row"><span>Historial</span><kbd>Ctrl+H</kbd></div>
                        <div class="shortcut-row"><span>Cambiar tema</span><kbd>Ctrl+D</kbd></div>
                        <div class="shortcut-row"><span>Configuración</span><kbd>Ctrl+,</kbd></div>
                        <div class="shortcut-row"><span>Cerrar diálogo</span><kbd>Esc</kbd></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="cmd-btn cmd-btn-primary" @onclick="() => showShortcutsTooltip = false">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}

@* Load Confirm Modal *@
@if (ViewModel.ShowingLoadConfirm)
{
    <div class="modal-backdrop fade show modal-backdrop-themed" aria-hidden="true"></div>
    <div class="modal d-block" tabindex="-1" role="dialog" aria-labelledby="confirm-load-title" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="confirm-load-title">
                        <Icon Name="alert-triangle" Size="15" />
                        <span>Reemplazar lista actual</span>
                    </h5>
                </div>
                <div class="modal-body">
                    <p class="mb-0" style="font-size: 13px; color: var(--text-secondary);">
                        Hay <strong style="color: var(--text-primary);">@ViewModel.Files.Count archivo@(ViewModel.Files.Count != 1 ? "s" : "")</strong> cargados en la sesión. ¿Quieres reemplazarlos por las nuevas carpetas?
                    </p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="cmd-btn" data-shortcut="escape" @onclick="() => ViewModel.CancelLoadFoldersCommand.Execute(null)">Cancelar</button>
                    <button type="button" class="cmd-btn cmd-btn-primary" @onclick="() => ViewModel.ConfirmLoadFoldersCommand.Execute(null)">Reemplazar</button>
                </div>
            </div>
        </div>
    </div>
}

@* Dry-Run Preview Modal *@
@if (ViewModel.ShowingDryRun)
{
    <div class="modal-backdrop fade show modal-backdrop-themed" aria-hidden="true"></div>
    <div class="modal d-block" tabindex="-1" role="dialog" aria-labelledby="dryrun-title" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="dryrun-title">
                        <Icon Name="check-circle" Size="15" />
                        <span>Confirmar renombrado (@ViewModel.DryRunPreview.Count archivo@(ViewModel.DryRunPreview.Count != 1 ? "s" : ""))</span>
                    </h5>
                    <button type="button" class="btn-close" data-shortcut="escape" @onclick="() => ViewModel.CancelDryRunCommand.Execute(null)" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body p-0" style="max-height: 400px; overflow-y: auto;">
                    <table class="table table-sm table-themed">
                        <thead>
                            <tr>
                                <th>Nombre actual</th>
                                <th>Nuevo nombre</th>
                            </tr>
                        </thead>
                        <tbody>
                            <Virtualize Items="@((ICollection<(string original, string preview)>)ViewModel.DryRunPreview)" Context="item" ItemSize="32f" OverscanCount="8">
                                <tr>
                                    <td class="mono-cell text-muted">@item.original</td>
                                    <td class="mono-cell" style="color: var(--accent); font-weight: 500;">@item.preview</td>
                                </tr>
                            </Virtualize>
                        </tbody>
                    </table>
                </div>
                <div class="modal-footer">
                    <button type="button" class="cmd-btn" @onclick="() => ViewModel.CancelDryRunCommand.Execute(null)">Cancelar</button>
                    <button type="button" class="cmd-btn cmd-btn-success" @onclick="() => ViewModel.ConfirmDryRunCommand.Execute(null)">
                        <Icon Name="check" Size="14" />
                        <span>Aplicar renombrado</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (ViewModel.ShowingFolderBrowser)
{
    <FolderBrowserDialog IsSingleSelectionMode="false"
                         OnAccept="@((folders) => ViewModel.LoadFoldersCommand.Execute(folders))"
                         OnCancel="() => ViewModel.HideFolderBrowserCommand.Execute(null)" />
}

@if (ViewModel.ShowingSettings)
{
    <SettingsDialog OnClose="() => ViewModel.CloseSettingsCommand.Execute(null)"
                    OnSaved="() => ViewModel.RefreshAllPreviewsCommand.Execute(null)" />
}

@if (ViewModel.ShowingTmdbSearch)
{
    <TmdbSearchDialog Files="@ViewModel.Files"
                      CurrentMode="@ViewModel.CurrentMode"
                      SelectedFile="@ViewModel.SelectedFile"
                      OnSeriesSelected="@((s) => ViewModel.ApplySeriesMetadataCommand.Execute(s))"
                      OnClose="() => ViewModel.CloseTmdbSearchCommand.Execute(null)" />
}

@if (ViewModel.ShowingSaveAll)
{
    <FolderBrowserDialog IsSingleSelectionMode="true"
                         OnAccept="@((folders) => ViewModel.MoveFilesCommand.Execute(folders))"
                         OnCancel="() => ViewModel.CloseSaveAllCommand.Execute(null)" />
}

@if (ViewModel.ShowingOperationLog)
{
    <OperationLogDialog OnClose="() => ViewModel.CloseOperationLogCommand.Execute(null)" />
}

@code {
    private bool showShortcutsTooltip = false;
    private bool showMoreMenu = false;
    private int _renderQueued;

    protected override async Task OnInitializedAsync()
    {
        ViewModel.ThemeService.SetJsRuntime(JS);
        await ViewModel.InitializeAsync();
        ViewModel.PropertyChanged += ViewModelPropertyChanged;

        if (ViewModel?.ThemeService != null)
        {
            ViewModel.ThemeService.ThemeChanged += OnThemeChanged;
        }
    }

    private void ViewModelPropertyChanged(object? sender, PropertyChangedEventArgs e)
    {
        if (Interlocked.Exchange(ref _renderQueued, 1) == 0)
        {
            InvokeAsync(() =>
            {
                Interlocked.Exchange(ref _renderQueued, 0);
                StateHasChanged();
            });
        }
    }

    private void OnThemeChanged(bool _)
    {
        InvokeAsync(StateHasChanged);
    }

    private void HandleDragOver(DragEventArgs e)
    {
        if (!ViewModel.IsDragging)
        {
            ViewModel.SetDragging(true);
        }
    }

    private void HandleDragLeave(DragEventArgs e)
    {
        ViewModel.SetDragging(false);
    }

    private async Task HandleDrop(DragEventArgs e)
    {
        await ViewModel.HandleDropAsync();
    }

    public void Dispose()
    {
        ViewModel.PropertyChanged -= ViewModelPropertyChanged;
        if (ViewModel?.ThemeService != null)
        {
            ViewModel.ThemeService.ThemeChanged -= OnThemeChanged;
        }
    }
}
