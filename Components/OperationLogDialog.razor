@using OrganizadorCapitulos.Maui.Services
@inject OperationLogService LogService

<div class="modal fade show d-block modal-backdrop-themed" tabindex="-1" role="dialog" aria-modal="true"
     aria-labelledby="operation-log-title">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="operation-log-title">
                    <Icon Name="history" Size="15" />
                    <span>Historial de operaciones</span>
                </h5>
                <button type="button" class="btn-close" data-shortcut="escape" @onclick="Close" aria-label="Cerrar diálogo"></button>
            </div>
            @{
                var entries = LogService.Entries;
            }
            <div class="modal-body p-0" style="max-height: 400px; overflow-y: auto;">
                @if (!entries.Any())
                {
                    <div class="p-4 text-center text-muted" style="font-size: 12.5px;">
                        No hay operaciones registradas.
                    </div>
                }
                else
                {
                    <table class="table table-sm table-themed">
                        <thead>
                            <tr>
                                <th style="width: 125px;">Fecha</th>
                                <th style="width: 82px;">Acción</th>
                                <th>Origen</th>
                                <th>Destino</th>
                                <th style="width: 56px; text-align: center;">Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in entries.Take(100))
                            {
                                <tr>
                                    <td class="tabular-nums text-muted">@entry.Timestamp.ToString("dd/MM HH:mm:ss")</td>
                                    <td>
                                        <span class="status-pill @GetActionPillClass(entry.Action)">
                                            @entry.Action
                                        </span>
                                    </td>
                                    <td class="mono-cell text-truncate" style="max-width: 200px;" title="@entry.OldName">
                                        @entry.OldName
                                    </td>
                                    <td class="mono-cell text-truncate" style="max-width: 200px;" title="@entry.NewName">
                                        @entry.NewName
                                    </td>
                                    <td style="text-align: center;">
                                        @if (entry.Status == "Success")
                                        {
                                            <span style="color: var(--success);" title="Correcto">
                                                <Icon Name="check" Size="13" />
                                            </span>
                                        }
                                        else
                                        {
                                            <span style="color: var(--danger);" title="@entry.Error">
                                                <Icon Name="x" Size="13" />
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
            <div class="modal-footer d-flex justify-content-between">
                <span class="text-muted tabular-nums" style="font-size: 12px;">
                    @entries.Count operación@(entries.Count != 1 ? "es" : "") registrada@(entries.Count != 1 ? "s" : "")
                </span>
                <div class="d-flex gap-2">
                    <button type="button" class="cmd-btn cmd-btn-danger-outline" @onclick="ClearLog"
                            disabled="@(!entries.Any())">
                        <Icon Name="trash" Size="13" />
                        <span>Limpiar</span>
                    </button>
                    <button type="button" class="cmd-btn cmd-btn-primary" @onclick="Close">
                        Cerrar
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public EventCallback OnClose { get; set; }

    private static string GetActionPillClass(string action) => action switch
    {
        "Rename" => "status-analyzed",
        "Undo" => "status-error",
        "Redo" => "status-pending",
        "Move" => "status-done",
        _ => "status-pending"
    };

    private void ClearLog()
    {
        LogService.Clear();
        StateHasChanged();
    }

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }
}
