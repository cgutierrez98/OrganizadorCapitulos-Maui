@using System.IO

<div class="folder-node">
    <div class="folder-node-row d-flex align-items-center py-1 px-2"
         style="padding-left: @(Level * 18 + 6)px; cursor: pointer;">

        @if (HasSubfolders)
        {
            <button type="button" class="folder-expand-btn me-1"
                    @onclick="ToggleExpandAsync"
                    @onclick:stopPropagation="true"
                    aria-label="@(IsExpanded ? $"Contraer {Name}" : $"Expandir {Name}")">
                @if (_isLoading)
                {
                    <Icon Name="clock" Size="12" />
                }
                else
                {
                    <Icon Name="@(IsExpanded ? "chevron-down" : "chevron-right")" Size="13" />
                }
            </button>
        }
        else
        {
            <span style="width: 20px; margin-right: 4px; display: inline-block;"></span>
        }

        <input type="checkbox"
               class="form-check-input me-2 mt-0"
               checked="@IsSelected"
               @onchange="OnCheckChanged" />

        <span @onclick="ToggleExpandAsync" class="user-select-none d-inline-flex align-items-center gap-2 flex-grow-1" style="min-width: 0;">
            <Icon Name="@(IsExpanded ? "folder-open" : "folder")" Size="14" />
            <span class="text-truncate">@Name</span>
        </span>
    </div>

    @if (IsExpanded && Subfolders.Any())
    {
        @foreach (var subfolder in Subfolders)
        {
            <FolderNode @key="subfolder.FullPath"
                        Path="@subfolder.FullPath"
                        Name="@subfolder.Name"
                        Level="@(Level + 1)"
                        SelectedFolders="@SelectedFolders"
                        OnSelectionChanged="@OnSelectionChanged"
                        IsSingleMode="@IsSingleMode" />
        }
    }
</div>

@code {
    [Parameter] public string Path { get; set; } = "";
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public int Level { get; set; } = 0;
    [Parameter] public HashSet<string> SelectedFolders { get; set; } = new();
    [Parameter] public EventCallback<(string path, bool isSelected)> OnSelectionChanged { get; set; }
    [Parameter] public bool IsSingleMode { get; set; } = false;

    private bool IsExpanded = false;
    private bool _isLoading = false;
    private bool HasSubfolders = true;
    private List<FolderInfo> Subfolders = new();
    private bool SubfoldersLoaded = false;

    private bool IsSelected => SelectedFolders.Contains(Path);

    private sealed class FolderInfo
    {
        public string Name { get; set; } = "";
        public string FullPath { get; set; } = "";
    }

    private async Task ToggleExpandAsync()
    {
        if (!HasSubfolders || _isLoading) return;

        IsExpanded = !IsExpanded;

        if (IsExpanded && !SubfoldersLoaded)
        {
            _isLoading = true;
            StateHasChanged();

            var targetPath = Path;
            var loaded = await Task.Run(() => LoadSubfoldersCore(targetPath));
            Subfolders = loaded;
            SubfoldersLoaded = true;
            HasSubfolders = Subfolders.Count > 0;
            _isLoading = false;
        }
    }

    private static List<FolderInfo> LoadSubfoldersCore(string directoryPath)
    {
        try
        {
            var options = new EnumerationOptions
            {
                IgnoreInaccessible = true,
                AttributesToSkip = FileAttributes.None
            };

            const FileAttributes hiddenSystem = FileAttributes.Hidden | FileAttributes.System;

            return new DirectoryInfo(directoryPath)
                .EnumerateDirectories("*", options)
                .Where(d => (d.Attributes & hiddenSystem) != hiddenSystem)
                .Select(d => new FolderInfo
                {
                    Name = d.Name,
                    FullPath = d.FullName
                })
                .OrderBy(f => f.Name, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
        catch
        {
            return new List<FolderInfo>();
        }
    }

    private async Task OnCheckChanged(ChangeEventArgs e)
    {
        bool isChecked = (bool)(e.Value ?? false);
        await OnSelectionChanged.InvokeAsync((Path, isChecked));
    }
}
